{
  "crons": [
    {
      "path": "/api/daily-digest",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/auth-watchdog",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire-packs",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/generate-sessions",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/smoke-test",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup-logs",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/complete-sessions",
      "schedule": "0 4 * * *"
    }
  ]
}
