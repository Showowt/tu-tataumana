# ══════════════════════════════════════════════════════
# TU. by Tata Umana - Environment Variables
# ══════════════════════════════════════════════════════

# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude AI (REQUIRED for chat/AI concierge)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Telegram Bot (REQUIRED for admin notifications)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Admin Authentication
TU_ADMIN_KEY=your-admin-key

# Wompi Payment Gateway (REQUIRED for online payments)
# Get these from: https://comercios.wompi.co/
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxx
WOMPI_INTEGRITY_KEY=test_integrity_xxxxxxxxxx

# Square Payments (optional, US market)
SQUARE_ACCESS_TOKEN=your-square-token
SQUARE_LOCATION_ID=your-location-id

# Cron Jobs
CRON_SECRET=your-cron-secret

# Application URL
NEXT_PUBLIC_APP_URL=https://www.tataumana.com

# Node environment
NODE_ENV=production
